# base.xvc - a number in decimal, hexadecimal, binary and octal
#   base 255           base 0xff        base 0b1010       base 0o17
#   base               asks, again and again (quit to leave)

fn digits_of(n, b) {
    if n == 0 { return "0" }
    let D = "0123456789abcdef"
    let out = ""
    while n > 0 {
        out = D[n % b] + out
        n = n / b
    }
    return out
}

# "255", "0xff", "0b1010", "0o17", "-12" -> the number, or nil
fn parse(text) {
    text = lower(trim(replace(text, "_", "")))
    let neg = startswith(text, "-")
    if neg { text = substr(text, 1) }
    let b = 10
    if startswith(text, "0x") { b = 16 }
    elif startswith(text, "0b") { b = 2 }
    elif startswith(text, "0o") { b = 8 }
    if b != 10 { text = substr(text, 2) }
    if text == "" or len(text) > 64 { return nil }
    let D = "0123456789abcdef"
    let n = 0
    for c in text {
        let v = find(D, c)
        if v < 0 or v >= b { return nil }
        if n > (9_223_372_036_854_775_807 - v) / b { return nil }
        n = n * b + v
    }
    if neg { n = -n }
    return n
}

fn group(s, size) {
    let out = ""
    let k = 0
    for i in range(len(s) - 1, -1, -1) {
        if k > 0 and k % size == 0 { out = "_" + out }
        out = s[i] + out
        k += 1
    }
    return out
}

fn show(text) {
    let n = parse(text)
    if n == nil {
        print("not a number: " + text + "   (write 255, 0xff, 0b1010 or 0o17)")
        return
    }
    let sign = ""
    let m = n
    if n < 0 {
        sign = "-"
        m = -n
    }
    print("  dec  " + sign + str(m))
    print("  hex  " + sign + "0x" + digits_of(m, 16))
    print("  bin  " + sign + "0b" + digits_of(m, 2))
    if m > 255 { print("       " + sign + "0b" + group(digits_of(m, 2), 4)) }
    print("  oct  " + sign + "0o" + digits_of(m, 8))
    if n >= 32 and n < 127 { print("  char '" + chr(n) + "'") }
    elif n > 160 and n < 1114112 and (n < 55296 or n > 57343) {
        let u = upper(digits_of(n, 16))
        while len(u) < 4 { u = "0" + u }
        print("  char " + chr(n) + "  (Unicode U+" + u + ")")
    }
}

if len(args) > 1 {
    for i in range(1, len(args)) { show(args[i]) }
    exit(0)
}
print("type a number (255, 0xff, 0b1010, 0o17); quit to leave")
while true {
    let line = input("base> ")
    if line == nil or trim(line) == "quit" or trim(line) == "q" { break }
    if trim(line) != "" { show(line) }
}
