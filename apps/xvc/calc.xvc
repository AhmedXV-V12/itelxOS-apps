# calc.xvc - a calculator that keeps fractions exact
#   calc                  interactive: type an expression, "help" for more
#   calc 2^10 + 1/3       works out one expression and ends
# 1/3 stays 1/3 and 0.1 + 0.2 is exactly 3/10. Numbers go up to 10^17.

let LIMIT = 100_000_000_000_000_000
let vars = {}
let toks = []
let pos = 0
let err = nil

fn fail(msg) {
    if err == nil { err = msg }
    return [0, 1]
}

fn iabs(x) {
    if x < 0 { return -x }
    return x
}

fn gcd(a, b) {
    a = iabs(a)
    b = iabs(b)
    while b != 0 {
        let t = a % b
        a = b
        b = t
    }
    return a
}

# whole numbers, checked against LIMIT
fn imul(a, b) {
    if a == 0 or b == 0 { return 0 }
    if iabs(a) > LIMIT / iabs(b) { fail("number too large (the limit is 10^17)"); return 0 }
    return a * b
}

fn iadd(a, b) {
    let r = a + b
    if iabs(r) > LIMIT { fail("number too large (the limit is 10^17)") }
    return r
}

# fractions are [numerator, denominator], denominator > 0, reduced
fn frac(n, d) {
    if d == 0 { return fail("division by zero") }
    if d < 0 {
        n = -n
        d = -d
    }
    let g = gcd(n, d)
    if g > 1 {
        n = n / g
        d = d / g
    }
    if iabs(n) > LIMIT or d > LIMIT { return fail("number too large (the limit is 10^17)") }
    return [n, d]
}

fn fadd(x, y) {
    let g = gcd(x[1], y[1])
    return frac(iadd(imul(x[0], y[1] / g), imul(y[0], x[1] / g)), imul(x[1] / g, y[1]))
}

fn fneg(x) { return [-x[0], x[1]] }

fn fmul(x, y) {
    let g1 = gcd(x[0], y[1])
    let g2 = gcd(y[0], x[1])
    if g1 == 0 { g1 = 1 }
    if g2 == 0 { g2 = 1 }
    return frac(imul(x[0] / g1, y[0] / g2), imul(x[1] / g2, y[1] / g1))
}

fn fdiv(x, y) {
    if y[0] == 0 { return fail("division by zero") }
    return fmul(x, [y[1], y[0]])
}

fn whole(x, what) {
    if x[1] != 1 { fail(what + " needs whole numbers") }
    return x[0]
}

fn fmod(x, y) {
    let a = whole(x, "%")
    let b = whole(y, "%")
    if err != nil { return [0, 1] }
    if b == 0 { return fail("division by zero") }
    return [a % b, 1]
}

fn fpow(x, y) {
    let e = whole(y, "^ (the power)")
    if err != nil { return [0, 1] }
    if iabs(e) > 4096 { return fail("the power is too large") }
    let neg = e < 0
    if neg { e = -e }
    let r = [1, 1]
    let b = x
    while e > 0 and err == nil {
        if e % 2 == 1 { r = fmul(r, b) }
        e = e / 2
        if e > 0 { b = fmul(b, b) }
    }
    if neg { return fdiv([1, 1], r) }
    return r
}

fn isqrt(n) {
    if n < 0 { fail("isqrt of a negative number"); return 0 }
    let lo = 0
    let hi = 1_000_000_000
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if mid * mid <= n { lo = mid } else { hi = mid - 1 }
    }
    return lo
}

# ------------------------------------------------------------- text

fn isdigit(c) { return c >= "0" and c <= "9" }
fn isletter(c) { return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" }

fn tokenize(line) {
    let out = []
    let i = 0
    let n = len(line)
    while i < n {
        let c = line[i]
        if c == " " or c == "\t" {
            i += 1
            continue
        }
        if isdigit(c) or c == "." {
            let start = i
            while i < n and (isdigit(line[i]) or line[i] == "." or line[i] == "_") { i += 1 }
            push(out, ["num", substr(line, start, i - start)])
            continue
        }
        if isletter(c) {
            let start = i
            while i < n and (isletter(line[i]) or isdigit(line[i])) { i += 1 }
            push(out, ["name", substr(line, start, i - start)])
            continue
        }
        if has("+-*/%^()=,", c) {
            push(out, ["op", c])
            i += 1
            continue
        }
        err = "unexpected '" + c + "'"
        return out
    }
    push(out, ["end", ""])
    return out
}

fn number(text) {
    text = replace(text, "_", "")
    let parts = split(text, ".")
    if len(parts) > 2 or text == "." { return fail("bad number '" + text + "'") }
    let digits = parts[0]
    let scale = 1
    if len(parts) == 2 {
        digits = digits + parts[1]
        for i in range(len(parts[1])) { scale = imul(scale, 10) }
    }
    if len(digits) > 17 { return fail("number too large (the limit is 10^17)") }
    let v = int(digits)
    if v == nil { v = 0 }
    return frac(v, scale)
}

# ----------------------------------------------------------- parser

fn peek() { return toks[pos] }

fn is_op(t, chars) { return t[0] == "op" and has(chars, t[1]) }

fn expect(op) {
    if is_op(peek(), op) { pos += 1 }
    else { fail("expected '" + op + "'") }
}

fn call(name, a) {
    if name == "abs" and len(a) == 1 { return [iabs(a[0][0]), a[0][1]] }
    if (name == "min" or name == "max") and len(a) > 0 {
        let best = a[0]
        for v in a {
            let d = fadd(v, fneg(best))
            if (name == "min" and d[0] < 0) or (name == "max" and d[0] > 0) { best = v }
        }
        return best
    }
    if (name == "gcd" or name == "lcm") and len(a) == 2 {
        let x = whole(a[0], name)
        let y = whole(a[1], name)
        if err != nil { return [0, 1] }
        let g = gcd(x, y)
        if name == "gcd" { return [g, 1] }
        if g == 0 { return [0, 1] }
        return [iabs(imul(x / g, y)), 1]
    }
    if name == "fact" and len(a) == 1 {
        let n = whole(a[0], "fact")
        if err != nil { return [0, 1] }
        if n < 0 or n > 20 { return fail("fact() takes 0 to 20") }
        let r = 1
        for i in range(2, n + 1) { r = imul(r, i) }
        return [r, 1]
    }
    if (name == "floor" or name == "ceil" or name == "round") and len(a) == 1 {
        let n = a[0][0]
        let d = a[0][1]
        let q = n / d
        if n % d != 0 {
            if name == "floor" and n < 0 { q -= 1 }
            if name == "ceil" and n > 0 { q += 1 }
            if name == "round" {
                let twice = iabs(n % d) * 2
                if twice >= d {
                    if n < 0 { q -= 1 } else { q += 1 }
                }
            }
        }
        return [q, 1]
    }
    if name == "isqrt" and len(a) == 1 { return [isqrt(whole(a[0], "isqrt")), 1] }
    return fail("unknown function " + name + "() with " + str(len(a)) + " argument(s)")
}

fn primary() {
    let t = peek()
    if t[0] == "num" {
        pos += 1
        return number(t[1])
    }
    if t[0] == "name" {
        pos += 1
        if is_op(peek(), "(") {
            pos += 1
            let a = []
            if not is_op(peek(), ")") {
                push(a, expr())
                while is_op(peek(), ",") and err == nil {
                    pos += 1
                    push(a, expr())
                }
            }
            expect(")")
            if err != nil { return [0, 1] }
            return call(t[1], a)
        }
        if has(vars, t[1]) { return vars[t[1]] }
        return fail("unknown name '" + t[1] + "'")
    }
    if is_op(t, "(") {
        pos += 1
        let v = expr()
        expect(")")
        return v
    }
    if t[0] == "end" { return fail("the expression is not finished") }
    return fail("unexpected '" + t[1] + "'")
}

fn power() {
    let b = primary()
    if is_op(peek(), "^") and err == nil {
        pos += 1
        return fpow(b, unary())
    }
    return b
}

fn unary() {
    if is_op(peek(), "-") {
        pos += 1
        return fneg(unary())
    }
    if is_op(peek(), "+") {
        pos += 1
        return unary()
    }
    return power()
}

fn term() {
    let x = unary()
    while is_op(peek(), "*/%") and err == nil {
        let op = peek()[1]
        pos += 1
        let y = unary()
        if op == "*" { x = fmul(x, y) }
        elif op == "/" { x = fdiv(x, y) }
        else { x = fmod(x, y) }
    }
    return x
}

fn expr() {
    let x = term()
    while is_op(peek(), "+-") and err == nil {
        let op = peek()[1]
        pos += 1
        let y = term()
        if op == "+" { x = fadd(x, y) } else { x = fadd(x, fneg(y)) }
    }
    return x
}

# ---------------------------------------------------------- output

fn decimal(x) {
    let n = iabs(x[0])
    let d = x[1]
    let out = str(n / d) + "."
    let r = n % d
    let digits = 0
    while r != 0 and digits < 12 {
        r = r * 10
        out = out + str(r / d)
        r = r % d
        digits += 1
    }
    if r != 0 { out = out + "..." }
    if x[0] < 0 { out = "-" + out }
    return out
}

fn show(x) {
    if x[1] == 1 { return str(x[0]) }
    return str(x[0]) + "/" + str(x[1]) + " = " + decimal(x)
}

# one line: an expression, or "name = expression"; prints the result
fn evaluate(line) {
    err = nil
    pos = 0
    toks = tokenize(line)
    if err != nil {
        print(color("red") + "error: " + err + color("reset"))
        return
    }
    let target = nil
    if len(toks) > 2 and toks[0][0] == "name" and is_op(toks[1], "=") {
        target = toks[0][1]
        pos = 2
    }
    let v = expr()
    if err == nil and peek()[0] != "end" { fail("unexpected '" + peek()[1] + "'") }
    if err != nil {
        print(color("red") + "error: " + err + color("reset"))
        return
    }
    vars["ans"] = v
    if target != nil {
        vars[target] = v
        print(target + " = " + show(v))
    } else {
        print("= " + show(v))
    }
}

fn help() {
    print("type an expression and press Enter, for example:")
    print("  1/3 + 1/6        2^10        (7 - 2) * 3.5        -17 % 5")
    print("  x = 12           x * 2       ans + 1   (ans is the last result)")
    print("functions: abs min max gcd lcm fact floor ceil round isqrt")
    print("commands:  help  vars  clear  quit")
}

if len(args) > 1 {
    let words = []
    for i in range(1, len(args)) { push(words, args[i]) }
    evaluate(join(words, " "))
    exit(0)
}

print(color("cyan") + "calc" + color("reset") + " - exact fractions; type help, or quit to leave")
while true {
    let line = input("calc> ")
    if line == nil { break }
    line = trim(line)
    if line == "" { continue }
    if line == "quit" or line == "exit" or line == "q" { break }
    if line == "help" { help(); continue }
    if line == "clear" {
        vars = {}
        print("variables cleared")
        continue
    }
    if line == "vars" {
        let names = keys(vars)
        sort(names)
        if len(names) == 0 { print("no variables yet") }
        for n in names { print("  " + n + " = " + show(vars[n])) }
        continue
    }
    evaluate(line)
}
