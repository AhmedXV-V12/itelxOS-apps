# primes.xvc - prime numbers
#   primes <n>            the primes up to n (n up to 200000)
#   primes factor <n>     n as a product of primes (n up to 10^12)
#   primes is <n>         whether n is prime (n up to 10^12)

let MAX_LIST = 200000
let MAX_TEST = 1_000_000_000_000

fn sieve(n) {
    let mark = []
    for i in range(n + 1) { push(mark, true) }
    mark[0] = false
    if n >= 1 { mark[1] = false }
    let i = 2
    while i * i <= n {
        if mark[i] {
            for j in range(i * i, n + 1, i) { mark[j] = false }
        }
        i += 1
    }
    let out = []
    for k in range(2, n + 1) {
        if mark[k] { push(out, k) }
    }
    return out
}

fn factors(n) {
    let out = []
    while n % 2 == 0 {
        push(out, 2)
        n = n / 2
    }
    let d = 3
    while d * d <= n {
        while n % d == 0 {
            push(out, d)
            n = n / d
        }
        d += 2
    }
    if n > 1 { push(out, n) }
    return out
}

fn number(text, max) {
    let n = int(text)
    if n == nil or n < 0 or n > max {
        print("give a whole number from 0 to " + str(max))
        exit(1)
    }
    return n
}

if len(args) < 2 {
    print("use: primes <n> | primes factor <n> | primes is <n>")
    exit(1)
}
let cmd = args[1]
if cmd == "factor" or cmd == "is" {
    if len(args) < 3 {
        print("use: primes " + cmd + " <n>")
        exit(1)
    }
    let n = number(args[2], MAX_TEST)
    if n < 2 {
        print(str(n) + " is neither prime nor composite")
        exit(0)
    }
    let f = factors(n)
    if cmd == "is" {
        if len(f) == 1 { print(str(n) + " is prime") }
        else { print(str(n) + " is not prime: " + str(n) + " = " + join(f, " x ")) }
    } else {
        # 360 = 2^3 x 3^2 x 5
        let parts = []
        let i = 0
        while i < len(f) {
            let p = f[i]
            let k = 0
            while i < len(f) and f[i] == p {
                k += 1
                i += 1
            }
            if k == 1 { push(parts, str(p)) } else { push(parts, str(p) + "^" + str(k)) }
        }
        print(str(n) + " = " + join(parts, " x "))
    }
    exit(0)
}
let n = number(cmd, MAX_LIST)
let list = sieve(n)
print(join(list, " "))
print(str(len(list)) + " primes up to " + str(n))
