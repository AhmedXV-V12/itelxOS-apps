# tree.xvc - a folder and everything in it, as a tree, with sizes
#   tree [folder] [depth]     e.g. tree /dex, tree / 2 (the folder: here)
#   tree -d [folder]          folders only

let only_dirs = false
let words = []
for i in range(1, len(args)) {
    if args[i] == "-d" { only_dirs = true } else { push(words, args[i]) }
}
let root = "."
let max_depth = 50
if len(words) > 0 { root = words[0] }
if len(words) > 1 {
    max_depth = int(words[1])
    if max_depth == nil or max_depth < 1 {
        print("use: tree [-d] [folder] [depth]")
        exit(1)
    }
}

let dirs = 0
let files = 0
let bytes = 0

fn size_text(n) {
    if n < 1024 { return str(n) + " B" }
    if n < 1048576 { return str(n / 1024) + "." + str(n % 1024 * 10 / 1024) + " KiB" }
    if n < 1073741824 { return str(n / 1048576) + "." + str(n % 1048576 * 10 / 1048576) + " MiB" }
    return str(n / 1073741824) + "." + str(n % 1073741824 * 10 / 1073741824) + " GiB"
}

fn walk(dir, prefix, depth) {
    let names = listdir(dir)
    if names == nil { return }
    sort(names)
    let shown = []
    for name in names {
        let path = dir + "/" + name
        if dir == "/" { path = "/" + name }
        let d = isdir(path)
        if d or not only_dirs { push(shown, [name, path, d]) }
    }
    for i in range(len(shown)) {
        let e = shown[i]
        let last = i == len(shown) - 1
        let branch = "├── "
        let more = "│   "
        if last {
            branch = "└── "
            more = "    "
        }
        if e[2] {
            dirs += 1
            print(prefix + branch + color("cyan") + e[0] + "/" + color("reset"))
            if depth < max_depth and e[1] != "/ram" { walk(e[1], prefix + more, depth + 1) }
        } else {
            files += 1
            let n = filesize(e[1])
            if n == nil { n = 0 }
            bytes += n
            print(prefix + branch + e[0] + "  " + color("dim") + size_text(n) + color("reset"))
        }
    }
}

if not isdir(root) {
    print(root + ": not a folder")
    exit(1)
}
print(color("cyan") + root + color("reset"))
walk(root, "", 1)
let summary = str(dirs) + " folder(s)"
if not only_dirs { summary = summary + ", " + str(files) + " file(s), " + size_text(bytes) }
print(summary)
